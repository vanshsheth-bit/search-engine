# Copy this file to `.env` and adjust. `.env` itself is gitignored, so real
# per-machine settings never get committed.

# Ollama server this app talks to for NL-query -> filter-JSON translation.
OLLAMA_URL=http://localhost:11434

# Local model used for query parsing. Switching machines is just this line --
# nothing else in the code needs to change.
#
# DESIGN TARGET (what the prompt in app/llm/prompt.py is actually written
# for): an 8B-class instruct model.
#   qwen3:8b              -- primary pick. Qwen's 2.5/3 series is
#                             particularly strong at schema-constrained
#                             JSON/function-calling output, which is exactly
#                             this app's job.
#   llama3.1:8b-instruct  -- free/open alternative, similarly strong at
#                             structured output. Worth comparing empirically
#                             once on real 8B-capable hardware.
#   gemma2:9b             -- another free/open alternative if either of the
#                             above underperforms on this project's queries.
# None of these three are benchmarked against each other in this repo yet --
# that comparison should happen on whatever hardware actually runs this in
# production (needs a GPU or Apple Silicon/Metal; confirmed unusable on
# CPU-only/8GB hardware -- multi-minute responses).
#
#   qwen3:4b  -- PRACTICAL default (this project's actual current default).
#                Not the design target above, but a real, workable middle
#                ground on CPU-only/8GB hardware. Noticeably weaker at
#                generalizing to phrasing the prompt didn't explicitly
#                anticipate than the 8B design target, but far more capable
#                than a 1.5B-class model. `ollama pull qwen3:4b`.
#
# On capable hardware: `ollama pull qwen3:8b`, then set:
# MODEL=qwen3:8b
MODEL=qwen3:4b

# Per-request timeout (seconds) for the Ollama call.
#   240 suits qwen3:4b on CPU-only/8GB hardware at the correct NUM_CTX below
#   (confirmed live: a real round-trip at num_ctx=12288 measured 204s).
#   ~60 is more appropriate for an 8B-class model on capable (GPU/Metal)
#   hardware -- an occasional slower response shouldn't fall back to a
#   generic "couldn't understand that" when it would have answered
#   correctly given a few more seconds.
LLM_TIMEOUT=240

# Retries before falling back to a CLARIFY response instead of erroring.
LLM_MAX_RETRIES=2

# Separate timeout for app/llm/skill_verify.py's LLM verification call, which
# runs with thinking ON (unlike the main query-translation call above, which
# stays think:False for speed). Thinking here is REQUIRED, not optional --
# confirmed live that think:False makes the model skip reasoning and
# rubber-stamp every shortlisted candidate as a match regardless of the
# skill asked for. Confirmed live: a 2-candidate verification call with
# thinking on took ~225s on CPU-only/8GB hardware; 400 leaves headroom for
# a full shortlist of up to 8.
SKILL_VERIFY_TIMEOUT=400

# Context window passed to Ollama. The v1 prompt (rules + few-shots, see
# app/llm/prompt.py) runs ~9,400 tokens -- 4096 (an earlier default here)
# silently truncated roughly HALF of it on every call, before the query or
# any conversation history even entered the count. 12288 leaves ~2,900
# tokens of headroom for history + query + response; bump further if
# FEW_SHOTS grows or conversations run long.
NUM_CTX=12288

# Session TTL (seconds) for the in-memory filter-state store.
SESSION_TTL=3600

# Which prompt/schema the LLM client uses to translate a query -- "v2"
# (default, app/llm/prompt_v2.py) or "v1" (app/llm/prompt.py). v2's prompt is
# roughly half the size of v1's, which is a real, measured latency win on
# CPU-only hardware (see app/core/config.py's Settings.prompt_schema
# docstring for the actual numbers) -- shorter context speeds up every
# decode step, not just the one-time prompt prefill. Switch to v1 only if
# comparing accuracy on a specific query pattern.
# PROMPT_SCHEMA=v2

# ---------------------------------------------------------------------------
# Skill semantic-similarity matching (app/core/semantic.py, app/llm/skill_verify.py)
# ---------------------------------------------------------------------------
# Widens a specific-tool skill filter to also catch a candidate who describes
# the same thing in different words (see semantic.py's docstring). Its OWN
# env vars, deliberately separate from EMBED_MODEL/EXPERIENCE_EMBED_MODEL
# below -- that's a different embedding task (full experience-description
# text) with its own, separately-verified model choice; reusing the same
# var name would silently couple the two.
#
# all-minilm: PRACTICAL default here -- confirmed empirically (real data,
# job 00000103) to separate signal from noise BETTER than nomic-embed-text
# despite being ~3x smaller (45MB vs 137MB): a wrong-but-plausible sibling
# skill (a Java/Selenium candidate against a "Python" query) topped out at
# 0.44 across the real candidate pool, while a genuine near-miss this
# feature exists to catch (TensorFlow/XGBoost/Keras against "scikit-learn")
# scored 0.52 -- a real, usable gap. nomic-embed-text's equivalent wrong-
# sibling case scored 0.62, ABOVE its own 0.55 threshold -- the exact
# false-positive bug (a Java/Selenium-only candidate counted as a "Python"
# match) this recalibration fixes. `ollama pull all-minilm`.
# SKILL_EMBED_MODEL=all-minilm
#
# Similarity at/above this counts as a genuine match, merged directly into
# results (see service.py's _fuzzy_skill_matches). 0.48 sits in the gap
# above -- MUST be re-tuned (do not reuse nomic's old 0.55) if
# SKILL_EMBED_MODEL changes, since different embedding models produce
# incomparable score distributions.
# SEMANTIC_MIN_SIMILARITY=0.48

# Candidate data sources. Real DB exports (gitignored -- contain real PII),
# not sample data. Defaults assume they sit at the repo root; override only
# if you've placed them elsewhere.
# PARSED_RESUMES_PATH=rebee_client_rebeeai.parsedresumes.json
# JD_MATCH_RESULTS_PATH=rebee_client_rebeeai.jdmatchresults.json
# MASTER_UNIVERSITIES_PATH=master_universities_simple.csv
# COMPANY_RANKS_PATH=company_ranks.json
# LOCATION_JSON_PATH=Location.json

# Skill/tool taxonomy (aliases, related tools) used by app/core/
# skill_taxonomy.py. info.json lists 11 domain files (Engineering, Finance,
# Legal, Healthcare, HR, Design, Marketing, Media, Operations, Leadership,
# Presales -- data/<Domain>.json, ~16,800 tools total). Falls back to the
# older, Engineering-only MERGED_TOOLS_PATH if INFO_JSON_PATH's file is
# missing.
# INFO_JSON_PATH=info.json
# MERGED_TOOLS_PATH=merged_tools.json

# ---------------------------------------------------------------------------
# Experience index (scripts/build_experience_index.py)
# ---------------------------------------------------------------------------

# Embedding model for experience chunks AND (with the default classifier
# backend) for the subdomain classifier's similarity stage. Must be an
# embedding model -- `ollama pull nomic-embed-text`.
# EXPERIENCE_EMBED_MODEL=nomic-embed-text

# Texts per /api/embed call. Higher is faster overall but makes each call
# longer; 64 measured well here at ~78ms/text on CPU.
# EMBED_BATCH_SIZE=64
# EMBED_TIMEOUT=300

# Similarity backend for the subdomain classifier:
#   ollama -- real sentence embeddings via the model above. Default.
#   tfidf  -- subdomain.py's offline stand-in. No network and much faster,
#             but no semantic generalization (its own docstring calls it a
#             correctness-testing backend, not a quality bar). Useful for
#             smoke-testing the pipeline with no model server running.
# CLASSIFIER_EMBED_BACKEND=ollama

# Where the classifier lives and what taxonomy it reads.
# SUBDOMAIN_CLASSIFIER_PATH=subdomain.py
# SUBDOMAINS_DATASET_PATH=master_subdomains_fixed.json

# Output stores (gitignored -- derived from real resume PII).
# EXPERIENCE_INDEX_DIR=experience_index
# EMBED_CACHE_DIR=.embed_cache
