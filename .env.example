# Copy this file to `.env` and adjust. `.env` itself is gitignored, so real
# per-machine settings never get committed.

# Ollama server this app talks to for NL-query -> filter-JSON translation.
OLLAMA_URL=http://localhost:11434

# Local model used for query parsing. Switching machines is just this line --
# nothing else in the code needs to change.
#
# DESIGN TARGET (what the prompt in app/llm/prompt.py is actually written
# for): an 8B-class instruct model.
#   qwen3:8b              -- primary pick. Qwen's 2.5/3 series is
#                             particularly strong at schema-constrained
#                             JSON/function-calling output, which is exactly
#                             this app's job.
#   llama3.1:8b-instruct  -- free/open alternative, similarly strong at
#                             structured output. Worth comparing empirically
#                             once on real 8B-capable hardware.
#   gemma2:9b             -- another free/open alternative if either of the
#                             above underperforms on this project's queries.
# None of these three are benchmarked against each other in this repo yet --
# that comparison should happen on whatever hardware actually runs this in
# production (needs a GPU or Apple Silicon/Metal; confirmed unusable on
# CPU-only/8GB hardware -- multi-minute responses).
#
#   qwen2.5:1.5b  -- NOT a design target, a dev-only stand-in for machines
#                    that can't run an 8B model at a usable speed. Fast
#                    (~seconds/query) but noticeably weaker at generalizing
#                    to phrasing the prompt didn't explicitly anticipate.
#
# On capable hardware: `ollama pull qwen3:8b`, then set:
# MODEL=qwen3:8b
MODEL=qwen2.5:1.5b

# Per-request timeout (seconds) for the Ollama call.
#   30 suits the small qwen2.5:1.5b dev fallback.
#   ~60 is more appropriate for an 8B-class model -- an occasional slower
#   response shouldn't fall back to a generic "couldn't understand that"
#   when it would have answered correctly given a few more seconds.
LLM_TIMEOUT=30

# Retries before falling back to a CLARIFY response instead of erroring.
LLM_MAX_RETRIES=2

# Context window passed to Ollama. The current prompt (rules + few-shots)
# runs ~2,800 tokens -- 4096 leaves comfortable room for the query + response.
NUM_CTX=4096

# Session TTL (seconds) for the in-memory filter-state store.
SESSION_TTL=3600

# Candidate data sources. Real DB exports (gitignored -- contain real PII),
# not sample data. Defaults assume they sit at the repo root; override only
# if you've placed them elsewhere.
# PARSED_RESUMES_PATH=rebee_client_rebeeai.parsedresumes.json
# JD_MATCH_RESULTS_PATH=rebee_client_rebeeai.jdmatchresults.json
# MASTER_UNIVERSITIES_PATH=master_universities.csv
# COMPANY_RANKS_PATH=company_ranks.json
# LOCATION_JSON_PATH=Location.json
# MERGED_TOOLS_PATH=merged_tools.json

# ---------------------------------------------------------------------------
# Experience index (scripts/build_experience_index.py)
# ---------------------------------------------------------------------------

# Embedding model for experience chunks AND (with the default classifier
# backend) for the subdomain classifier's similarity stage. Must be an
# embedding model -- `ollama pull nomic-embed-text`.
# EXPERIENCE_EMBED_MODEL=nomic-embed-text

# Texts per /api/embed call. Higher is faster overall but makes each call
# longer; 64 measured well here at ~78ms/text on CPU.
# EMBED_BATCH_SIZE=64
# EMBED_TIMEOUT=300

# Similarity backend for the subdomain classifier:
#   ollama -- real sentence embeddings via the model above. Default.
#   tfidf  -- subdomain.py's offline stand-in. No network and much faster,
#             but no semantic generalization (its own docstring calls it a
#             correctness-testing backend, not a quality bar). Useful for
#             smoke-testing the pipeline with no model server running.
# CLASSIFIER_EMBED_BACKEND=ollama

# Where the classifier lives and what taxonomy it reads.
# SUBDOMAIN_CLASSIFIER_PATH=subdomain.py
# SUBDOMAINS_DATASET_PATH=master_subdomains_fixed.json

# Output stores (gitignored -- derived from real resume PII).
# EXPERIENCE_INDEX_DIR=experience_index
# EMBED_CACHE_DIR=.embed_cache
